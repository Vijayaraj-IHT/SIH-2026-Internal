# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Datasets & audio corpora
# Raw corpora and the TFRecord cache live OUTSIDE version control: the cache is
# several hundred megabytes and the corpora are licensed audio that should not
# be redistributed in Git history.  Everything here is reproducible with
# `make data && make cache` (see README).
#
# NOTE: the leading slash is load-bearing.  A bare `data/` also matches the
# source directory `ml/data/`, which silently removes the entire data pipeline
# from the repository.
# ---------------------------------------------------------------------------
/data/
*.wav
*.flac
*.mp3
*.ogg
*.opus
*.tar.gz
*.zip

# ---------------------------------------------------------------------------
# Edge builds
# ---------------------------------------------------------------------------
edge/build/
edge/**/build/
edge/**/managed_components/
edge/host_sim/tflite-micro/
edge/host_sim/gen/
*.o
*.a
*.elf
*.bin
*.map
sdkconfig
sdkconfig.old
# Generated from the run's export_report.json - regenerate with `make frontend`.
edge/common/kws_frontend_tables.h
edge/esp32/main/model_int8_tflite.h

# ---------------------------------------------------------------------------
# Artifacts: large or regenerable files are ignored, while the small int8 model
# binaries stay tracked on purpose - the reviewer should be able to open
# artifacts/<run>/model_int8.tflite without training anything.
# ---------------------------------------------------------------------------
artifacts/**/*.h5
artifacts/**/*.keras
artifacts/**/*.ckpt*
artifacts/**/features_*.npz
artifacts/**/*.log
artifacts/tmp/

# server runtime state
server/data/*.db
server/data/*.db-journal
server/data/*.db-wal

# ---------------------------------------------------------------------------
# OS / editors
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
